---
import { formatDate } from '../../../shared/utils';
import GitContext from './GitContext.astro';

interface Props {
  issue: any;
  showBeadsId?: boolean;
  showGitContext?: boolean;
  isReadOnly?: boolean;
  backLink?: { url: string; label: string };
}

const {
  issue,
  showBeadsId = false,
  showGitContext = false,
  isReadOnly = false,
  backLink,
} = Astro.props;

// Handle different timestamp formats
const formatTimestamp = (timestamp: number | string): string => {
  if (typeof timestamp === 'number') {
    // Unix timestamp in seconds
    if (timestamp < 10000000000) {
      return formatDate(timestamp);
    }
    // Unix timestamp in milliseconds
    return new Date(timestamp).toLocaleDateString();
  }
  // String date
  try {
    return new Date(timestamp).toLocaleDateString();
  } catch {
    return String(timestamp);
  }
};
---

<div class="issue-detail">
  {backLink && (
    <div class="back-link-container">
      <a href={backLink.url} class="back-link">← {backLink.label}</a>
    </div>
  )}

  <div class="issue-header">
    <div class="header-left">
      {showBeadsId && issue.beads_id && (
        <span class="issue-id">{issue.beads_id}</span>
      )}
      {!showBeadsId && issue.id && (
        <span class="issue-id">{issue.id}</span>
      )}
      <h1 class="issue-title">{issue.title}</h1>
    </div>
    <div class="header-right">
      <span class={`badge status ${issue.status}`}>{issue.status}</span>
      {issue.priority !== undefined && issue.priority !== null && (
        <span class={`badge priority p${issue.priority}`}>
          P{issue.priority}
        </span>
      )}
    </div>
  </div>

  {issue.body && (
    <div class="issue-body">
      {issue.body}
    </div>
  )}

  <div class="metadata-compact">
    {showBeadsId && (
      <div class="meta-row">
        <span class="meta-label">id:</span>
        <span class="meta-value">{issue.beads_id}</span>
      </div>
    )}

    {issue.labels && issue.labels.length > 0 && (
      <div class="meta-row">
        <span class="meta-label">labels:</span>
        <div class="labels-list">
          {issue.labels.map((label: string) => (
            <span class="badge label">{label}</span>
          ))}
        </div>
      </div>
    )}

    {issue.issue_type && (
      <div class="meta-row">
        <span class="meta-label">type:</span>
        <span class="meta-value">{issue.issue_type}</span>
      </div>
    )}

    {showGitContext && (issue.git_branch || issue.git_commit_hash) && (
      <div class="meta-row">
        <span class="meta-label">git:</span>
        <GitContext
          repoUrl={issue.git_repo_url}
          branch={issue.git_branch}
          commit={issue.git_commit_hash}
          isDirty={issue.git_is_dirty}
        />
      </div>
    )}

    <div class="meta-row">
      <span class="meta-label">created:</span>
      <span class="meta-value">{formatTimestamp(issue.created_at)}</span>
    </div>

    <div class="meta-row">
      <span class="meta-label">updated:</span>
      <span class="meta-value">{formatTimestamp(issue.updated_at)}</span>
    </div>

    {issue.closed_at && (
      <div class="meta-row">
        <span class="meta-label">closed:</span>
        <span class="meta-value">{formatTimestamp(issue.closed_at)}</span>
      </div>
    )}
  </div>

  <slot />
</div>

<style>
  .back-link-container {
    margin-bottom: var(--space-lg);
  }

  .back-link {
    color: var(--color-primary);
    text-decoration: none;
    font-size: var(--font-base);
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
