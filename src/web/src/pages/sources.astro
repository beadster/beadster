---
import Layout from '../layouts/Layout.astro';
import { getSourcesWithStats } from '../../../shared/database';

// Require authentication
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

let sources: any[] = [];
let error: string | null = null;

try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db) {
    sources = await getSourcesWithStats(db, Astro.locals.user.id);
  } else {
    error = 'Database binding not available';
  }
} catch (e) {
  error = `Failed to fetch: ${e instanceof Error ? e.message : String(e)}`;
}

function formatDate(timestamp: number): string {
  return new Date(timestamp).toLocaleDateString();
}

function formatRelativeTime(timestamp: number): string {
  const now = Date.now();
  const diff = now - timestamp;
  const seconds = Math.floor(diff / 1000);
  const minutes = Math.floor(seconds / 60);
  const hours = Math.floor(minutes / 60);
  const days = Math.floor(hours / 24);

  if (days > 0) return `${days}d ago`;
  if (hours > 0) return `${hours}h ago`;
  if (minutes > 0) return `${minutes}m ago`;
  return 'just now';
}
---

<Layout title="projects">
  <h2>projects / sources</h2>

  {error && (
    <div class="error">{error}</div>
  )}

  {!error && sources.length === 0 && (
    <div class="empty">
      <p>no projects found</p>
      <p style="font-size: 14px; color: #666; margin-top: 10px;">
        run the sync daemon to register your local beads projects
      </p>
    </div>
  )}

  {!error && sources.length > 0 && (
    <ul class="source-list">
      {sources.map(source => (
        <li class="source-item">
          <div class="source-header">
            <h3 class="source-name">{source.name}</h3>
            <div class="source-badges">
              {source.is_mirror === 1 ? (
                <span class="badge mirror">🔄 mirror</span>
              ) : (
                <span class="badge owned">📝 owned</span>
              )}
              <span class={`badge type ${source.type}`}>{source.type}</span>
            </div>
          </div>

          {source.path && (
            <div class="source-path">{source.path}</div>
          )}

          {source.git_repo_url && (
            <div class="source-git-url">
              <a href={source.git_repo_url} target="_blank" rel="noopener">
                {source.git_repo_url}
              </a>
            </div>
          )}

          <div class="source-stats">
            <div class="stat">
              <span class="stat-value">{source.issue_count}</span>
              <span class="stat-label">total issues</span>
            </div>
            <div class="stat">
              <span class="stat-value">{source.open_count}</span>
              <span class="stat-label">open</span>
            </div>
            <div class="stat">
              <span class="stat-value">{source.last_issue_number || 0}</span>
              <span class="stat-label">last number</span>
            </div>
            {source.is_mirror === 1 && source.auto_sync === 1 && (
              <div class="stat">
                <span class="stat-value">every {source.sync_interval_minutes}m</span>
                <span class="stat-label">auto-sync</span>
              </div>
            )}
          </div>

          <div class="source-meta">
            <span>created {formatDate(source.created_at)}</span>
            {source.last_sync && (
              <span>• last sync {formatRelativeTime(source.last_sync)}</span>
            )}
          </div>

          {source.is_mirror !== 1 && (
            <div class="source-actions">
              <a href={`/new?source=${source.id}`} class="btn-primary-small">+ new issue</a>
              <a href={`/?source=${source.id}`} class="btn-secondary-small">view issues</a>
            </div>
          )}

          {source.is_mirror === 1 && (
            <div class="source-actions">
              <a href={`/?source=${source.id}`} class="btn-secondary-small">view issues</a>
              <span class="read-only-notice">read-only mirror</span>
            </div>
          )}
        </li>
      ))}
    </ul>
  )}
</Layout>

<style>
  .source-list {
    list-style: none;
    padding: 0;
    margin: 20px 0;
  }

  .source-item {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 15px;
    background: var(--bg-primary);
  }

  .source-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .source-name {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
  }

  .source-badges {
    display: flex;
    gap: 8px;
  }

  .badge {
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
  }

  .badge.mirror {
    background: #e3f2fd;
    color: #1976d2;
  }

  .badge.owned {
    background: #e8f5e9;
    color: #2e7d32;
  }

  .badge.type {
    background: #f5f5f5;
    color: #666;
  }

  .source-path {
    font-size: 13px;
    color: var(--text-secondary);
    font-family: monospace;
    margin-bottom: 10px;
  }

  .source-git-url {
    font-size: 13px;
    margin-bottom: 10px;
  }

  .source-git-url a {
    color: var(--primary-color);
    text-decoration: none;
  }

  .source-git-url a:hover {
    text-decoration: underline;
  }

  .source-stats {
    display: flex;
    gap: 30px;
    margin: 15px 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-value {
    font-size: 20px;
    font-weight: 600;
  }

  .stat-label {
    font-size: 12px;
    color: var(--text-secondary);
    text-transform: uppercase;
  }

  .source-meta {
    display: flex;
    gap: 10px;
    font-size: 13px;
    color: var(--text-secondary);
    margin-top: 10px;
  }

  .source-actions {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid var(--border-color);
  }

  .btn-primary-small, .btn-secondary-small {
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 13px;
    text-decoration: none;
    display: inline-block;
    cursor: pointer;
  }

  .btn-primary-small {
    background: var(--primary-color);
    color: white;
    border: none;
  }

  .btn-primary-small:hover {
    opacity: 0.9;
  }

  .btn-secondary-small {
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .btn-secondary-small:hover {
    background: var(--border-color);
  }

  .read-only-notice {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .empty {
    text-align: center;
    padding: 40px;
    color: var(--text-secondary);
  }

  .error {
    padding: 15px;
    background: #ffebee;
    border: 1px solid #f44336;
    color: #c62828;
    border-radius: 8px;
    margin-bottom: 20px;
  }
</style>

