---
import Layout from '../layouts/Layout.astro';
import { getSourcesWithStats } from '../../../shared/database';
import { formatDate, formatRelativeTime } from '../../../shared/utils';

// Require authentication
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

let sources: any[] = [];
let error: string | null = null;

try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db) {
    sources = await getSourcesWithStats(db, Astro.locals.user.id);
  } else {
    error = 'Database binding not available';
  }
} catch (e) {
  error = `Failed to fetch: ${e instanceof Error ? e.message : String(e)}`;
}
---

<Layout title="projects">
  <h2>projects / sources</h2>

  {error && (
    <div class="error">{error}</div>
  )}

  {!error && sources.length === 0 && (
    <div class="empty">
      <p>no projects found</p>
      <p class="secondary-text">
        run the sync daemon to register your local beads projects
      </p>
    </div>
  )}

  {!error && sources.length > 0 && (
    <ul class="source-list">
      {sources.map(source => (
        <li class="source-item">
          <a href={`/?source=${source.id}`} class="source-link">
            <div class="source-header">
              <h3 class="source-name">{source.name}</h3>
              <div class="source-stats-inline">
                <span class="stat-badge">{source.issue_count} total</span>
                <span class="stat-badge open">{source.open_count} open</span>
                {source.is_mirror === 1 ? (
                  <span class="badge mirror">🔄 mirror</span>
                ) : (
                  <span class="badge owned">📝 owned</span>
                )}
                <span class={`badge type ${source.type}`}>{source.type}</span>
              </div>
            </div>

            {source.path && (
              <div class="source-path">{source.path}</div>
            )}

            {source.git_repo_url && (
              <div class="source-git-url">{source.git_repo_url}</div>
            )}

            <div class="source-meta">
              <span>created {formatDate(source.created_at)}</span>
              {source.last_sync && (
                <span>• last sync {formatRelativeTime(source.last_sync)}</span>
              )}
              <span>• last #{source.last_issue_number || 0}</span>
              {source.is_mirror === 1 && source.auto_sync === 1 && (
                <span>• auto-sync every {source.sync_interval_minutes}m</span>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</Layout>

<style>
  .source-list {
    list-style: none;
    padding: 0;
    margin: 10px 0;
  }

  .source-item {
    background: var(--color-bg-light);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    margin-bottom: 10px;
    transition: all 0.2s;
  }

  .source-item::before {
    content: none !important;
  }

  .source-item:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-lighter);
  }

  .source-link {
    display: block;
    padding: 12px;
    text-decoration: none;
    color: inherit;
  }

  .source-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .source-name {
    margin: 0;
    font-size: var(--font-lg);
    font-weight: 500;
    color: var(--color-text);
  }

  .source-stats-inline {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .stat-badge {
    padding: 3px 8px;
    border-radius: 12px;
    font-size: var(--font-sm);
    font-weight: 500;
    background: var(--color-neutral);
    color: var(--color-text-light);
  }

  .stat-badge.open {
    background: var(--color-success-bg);
    color: var(--color-success-dark);
  }

  .badge {
    padding: 3px 8px;
    border-radius: 4px;
    font-size: var(--font-sm);
    font-weight: 500;
    text-transform: uppercase;
  }

  .badge.mirror {
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .badge.owned {
    background: var(--color-success-bg);
    color: var(--color-success-dark);
  }

  .badge.type {
    background: var(--color-neutral);
    color: var(--color-text-light);
  }

  .source-path {
    font-size: var(--font-sm);
    color: var(--color-text-light);
    font-family: var(--font-mono);
    margin-bottom: 6px;
  }

  .source-git-url {
    font-size: var(--font-sm);
    color: var(--color-text-light);
    font-family: var(--font-mono);
    margin-bottom: 6px;
  }

  .source-meta {
    display: flex;
    gap: 8px;
    font-size: var(--font-sm);
    color: var(--color-text-lighter);
  }

</style>

