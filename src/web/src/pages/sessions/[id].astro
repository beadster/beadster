---
import Layout from '../../layouts/Layout.astro';
import IssueListItem from '../../components/IssueListItem.astro';
import { getSessionIssues } from '../../../../shared/database';

// Require authentication
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

const { id } = Astro.params;

interface Issue {
  id: string;
  user_id: string;
  beads_id: string;
  title: string;
  body: string | null;
  status: string;
  priority: number | null;
  labels: string[] | null;
  session_id: string | null;
  client: string | null;
  project_name: string | null;
  created_at: number;
  updated_at: number;
  closed_at: number | null;
}

let issues: Issue[] = [];
let error: string | null = null;
let sessionInfo: { client: string; project_name: string | null } | null = null;

try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db && id) {
    issues = await getSessionIssues(db, Astro.locals.user.id, id) as Issue[];

    // Extract session info from first issue
    if (issues.length > 0) {
      sessionInfo = {
        client: issues[0].client || 'unknown',
        project_name: issues[0].project_name
      };
    }
  } else {
    error = 'Database binding not available';
  }
} catch (e) {
  error = `Failed to fetch: ${e instanceof Error ? e.message : String(e)}`;
}
---

<Layout title="session">
  <div class="back-link-wrapper">
    <a href="/sessions" class="back-link">← back to sessions</a>
  </div>

  <div class="section-wrapper">
    <h2>session details</h2>
    {sessionInfo && (
      <div class="meta-section">
        <span class="badge client">{sessionInfo.client}</span>
        {sessionInfo.project_name && (
          <span class="badge badge-ml">{sessionInfo.project_name}</span>
        )}
      </div>
    )}
  </div>

  {error && (
    <div class="error">
      <p>{error}</p>
    </div>
  )}

  {!error && issues.length === 0 && (
    <div class="empty">
      <p>no issues in this session</p>
    </div>
  )}

  {!error && issues.length > 0 && (
    <div>
      <h3 class="section-header">
        {issues.length} issue{issues.length !== 1 ? 's' : ''} in this session
      </h3>
      <ul class="issue-list">
        {issues.map(issue => (
          <IssueListItem
            issue={issue}
            showSessionInfo={false}
            showGitInfo={false}
            showExternalRef={false}
          />
        ))}
      </ul>
    </div>
  )}
</Layout>

