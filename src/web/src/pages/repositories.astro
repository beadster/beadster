---
import Layout from '../layouts/Layout.astro';
import { getRepositories } from '../../../shared/database';
import { formatRelativeTime, getRepoName } from '../../../shared/utils';

// Require authentication
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

let repositories: any[] = [];
let error: string | null = null;

try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db) {
    repositories = await getRepositories(db, Astro.locals.user.id);
  } else {
    error = 'Database binding not available';
  }
} catch (e) {
  error = `Failed to fetch: ${e instanceof Error ? e.message : String(e)}`;
}
---

<Layout title="repositories">
  <nav class="tabs">
    <a href="/">open</a>
    <a href="/all">all</a>
    <a href="/closed">closed</a>
    <a href="/labels">labels</a>
    <a href="/tree">tree</a>
    <a href="/repositories" class="active">repositories</a>
    <a href="/stats">stats</a>
  </nav>

  <h2>git repositories</h2>

  {error && (
    <div class="error">{error}</div>
  )}

  {!error && repositories.length === 0 && (
    <div class="empty">
      <p>no repositories found</p>
      <p class="secondary-text">
        issues with git context will appear here automatically
      </p>
    </div>
  )}

  {!error && repositories.length > 0 && (
    <ul class="repo-list">
      {repositories.map(repo => (
        <li class="repo-item">
          <a href={`/?repo=${encodeURIComponent(repo.git_repo_url)}`} class="repo-link">
            <div class="repo-header">
              <h3 class="repo-name">{getRepoName(repo.git_repo_url)}</h3>
              <div class="repo-stats-inline">
                <span class="stat-badge open">{repo.open_issues} open</span>
                <span class="stat-badge closed">{repo.closed_issues} closed</span>
              </div>
            </div>

            <div class="repo-url">{repo.git_repo_url}</div>

            <div class="repo-stats">
              <div class="stat">
                <span class="stat-value">{repo.total_issues}</span>
                <span class="stat-label">total issues</span>
              </div>
              <div class="stat">
                <span class="stat-value">{repo.open_issues}</span>
                <span class="stat-label">open</span>
              </div>
              <div class="stat">
                <span class="stat-value">{repo.closed_issues}</span>
                <span class="stat-label">closed</span>
              </div>
              {repo.latest_activity && (
                <div class="stat">
                  <span class="stat-value">{formatRelativeTime(repo.latest_activity)}</span>
                  <span class="stat-label">last activity</span>
                </div>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  )}
</Layout>

