---
import Layout from '../layouts/Layout.astro';
import { getSources } from '../../../shared/database';

// Require authentication
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

let sources: any[] = [];
let error: string | null = null;

try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db) {
    sources = await getSources(db, Astro.locals.user.id);
  } else {
    error = 'Database binding not available';
  }
} catch (e) {
  error = `Failed to fetch: ${e instanceof Error ? e.message : String(e)}`;
}
---

<Layout title="new issue">
  <div class="header">
    <h2>create new issue</h2>
    <a href="/" class="back-link">← back to issues</a>
  </div>

  {error && (
    <div class="error">{error}</div>
  )}

  {!error && sources.length === 0 && (
    <div class="error">
      no projects/sources found. run sync daemon first to create a source.
    </div>
  )}

  {!error && sources.length > 0 && (
    <form id="issue-form" class="issue-form">
      <div class="form-group">
        <label for="source">project</label>
        <select id="source" name="source" required>
          <option value="">select project...</option>
          {sources.map(source => (
            <option value={source.id}>{source.name}</option>
          ))}
        </select>
      </div>

      <div class="form-group">
        <label for="title">title</label>
        <input type="text" id="title" name="title" required autofocus>
      </div>

    <div class="form-group">
      <label for="body">description</label>
      <textarea id="body" name="body" rows="5"></textarea>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="priority">priority</label>
        <select id="priority" name="priority">
          <option value="0">P0 - critical</option>
          <option value="1" selected>P1 - high</option>
          <option value="2">P2 - normal</option>
          <option value="3">P3 - low</option>
          <option value="4">P4 - lowest</option>
        </select>
      </div>

      <div class="form-group">
        <label for="status">status</label>
        <select id="status" name="status">
          <option value="open" selected>open</option>
          <option value="in_progress">in progress</option>
          <option value="blocked">blocked</option>
          <option value="closed">closed</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label for="issue_type">type</label>
      <select id="issue_type" name="issue_type">
        <option value="task" selected>task</option>
        <option value="bug">bug</option>
        <option value="feature">feature</option>
        <option value="epic">epic</option>
        <option value="chore">chore</option>
      </select>
    </div>

    <div class="form-group">
      <label for="assignee">assignee (optional)</label>
      <input type="text" id="assignee" name="assignee" placeholder="username">
      <small>leave blank for unassigned</small>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-primary">create issue</button>
      <a href="/" class="btn-secondary">cancel</a>
    </div>

      <div id="error" class="error" style="display: none;"></div>
    </form>
  )}
</Layout>


<script>
  const form = document.getElementById('issue-form') as HTMLFormElement;
  const errorDiv = document.getElementById('error') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = {
      source_id: formData.get('source'),
      title: formData.get('title'),
      body: formData.get('body') || null,
      priority: parseInt(formData.get('priority') as string),
      status: formData.get('status'),
      issue_type: formData.get('issue_type')
    };

    try {
      const response = await fetch('/api/issues/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || 'Failed to create issue');
      }

      window.location.href = '/';
    } catch (err) {
      errorDiv.textContent = err instanceof Error ? err.message : 'Failed to create issue';
      errorDiv.style.display = 'block';
    }
  });
</script>
