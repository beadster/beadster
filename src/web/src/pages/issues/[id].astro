---
import Layout from '../../layouts/Layout.astro';
import GitContext from '../../components/GitContext.astro';
import { getIssue } from '../../../../shared/database';

// Require authentication
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

const { id } = Astro.params;

let issue: any = null;
let error: string | null = null;

try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db && id) {
    issue = await getIssue(db, Astro.locals.user.id, id);
    if (!issue) {
      error = 'Issue not found';
    }
  } else {
    error = 'Database binding not available';
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Unknown error';
}
---

<Layout title={issue ? issue.title : 'issue'}>
  {error && (
    <div class="error">{error}</div>
  )}

  {issue && (
    <div class="issue-detail">
      <div class="issue-header">
        <div class="header-left">
          <span class="issue-id">{issue.beads_id}</span>
          <h1 class="issue-title">{issue.title}</h1>
        </div>
        <div class="header-right">
          <span class={`badge status ${issue.status}`}>{issue.status}</span>
          {issue.priority && (
            <span class={`badge priority p${issue.priority.replace('P', '')}`}>
              {issue.priority}
            </span>
          )}
        </div>
      </div>

      {issue.body && (
        <div class="issue-body">
          {issue.body}
        </div>
      )}

      <div class="metadata-compact">
        {issue.labels && issue.labels.length > 0 && (
          <div class="meta-row">
            <span class="meta-label">labels:</span>
            <div class="labels-list">
              {issue.labels.map((label: string) => (
                <span class="badge label">{label}</span>
              ))}
            </div>
          </div>
        )}

        {(issue.git_branch || issue.git_commit_hash) && (
          <div class="meta-row">
            <span class="meta-label">git:</span>
            <GitContext
              repoUrl={issue.git_repo_url}
              branch={issue.git_branch}
              commit={issue.git_commit_hash}
              isDirty={issue.git_is_dirty}
            />
          </div>
        )}

        <div class="meta-row">
          <span class="meta-label">created:</span>
          <span class="meta-value">
            {new Date(issue.created_at * 1000).toLocaleDateString()}
          </span>
        </div>

        <div class="meta-row">
          <span class="meta-label">updated:</span>
          <span class="meta-value">
            {new Date(issue.updated_at * 1000).toLocaleDateString()}
          </span>
        </div>
      </div>

      <div class="actions-section">
        <h3>actions</h3>
        <form id="update-form" class="update-form">
          <div class="form-group">
            <label for="title">title</label>
            <input type="text" id="title" name="title" value={issue.title} required />
          </div>

          <div class="form-group">
            <label for="body">description</label>
            <textarea id="body" name="body" rows="5">{issue.body || ''}</textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="status">status</label>
              <select id="status" name="status">
                <option value="open" selected={issue.status === 'open'}>open</option>
                <option value="closed" selected={issue.status === 'closed'}>closed</option>
              </select>
            </div>

            <div class="form-group">
              <label for="priority">priority</label>
              <input type="text" id="priority" name="priority" value={issue.priority || ''} placeholder="P0, P1, P2..." />
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">update issue</button>
            <button type="button" class="btn btn-danger" id="close-btn">close issue</button>
            <a href="/" class="btn btn-secondary">cancel</a>
          </div>
        </form>
      </div>
    </div>
  )}
</Layout>

<style>
  .error {
    padding: 12px;
    background: #fee;
    border: 1px solid #fcc;
    border-radius: 4px;
    color: #c00;
    font-size: 14px;
  }

  .issue-detail {
    max-width: 900px;
    margin: 0 auto;
  }

  .issue-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid #e0e0e0;
  }

  .header-left,
  .header-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .issue-id {
    font-family: monospace;
    color: #999;
    font-size: 13px;
  }

  .issue-title {
    font-size: 20px;
    margin: 0;
    font-weight: 600;
  }

  .issue-body {
    padding: 12px;
    background: #f9f9f9;
    border-radius: 4px;
    margin-bottom: 12px;
    white-space: pre-wrap;
    line-height: 1.5;
    font-size: 14px;
  }

  .metadata-compact {
    margin-bottom: 20px;
    font-size: 13px;
    padding: 8px 0;
    border-top: 1px solid #f0f0f0;
    border-bottom: 1px solid #f0f0f0;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
  }

  .meta-label {
    color: #999;
    min-width: 60px;
    font-size: 12px;
  }

  .meta-value {
    color: #333;
  }

  .labels-list {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .badge.label {
    background: #e8f4ff;
    color: #0066cc;
    font-size: 11px;
    padding: 2px 8px;
  }

  .actions-section {
    margin-top: 20px;
  }

  .actions-section h3 {
    font-size: 14px;
    margin-bottom: 10px;
    color: #666;
    font-weight: 600;
  }

  .update-form {
    background: #f9f9f9;
    padding: 16px;
    border-radius: 4px;
  }

  .form-group {
    margin-bottom: 12px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .form-group label {
    display: block;
    margin-bottom: 4px;
    font-size: 12px;
    font-weight: 500;
    color: #666;
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    width: 100%;
    padding: 6px 10px;
    border: 1px solid #ddd;
    border-radius: 3px;
    font-size: 13px;
    font-family: inherit;
  }

  .form-group textarea {
    resize: vertical;
  }

  .form-actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .btn {
    padding: 6px 14px;
    border: none;
    border-radius: 3px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }

  .btn-primary {
    background: #0066cc;
    color: #fff;
  }

  .btn-primary:hover {
    background: #0052a3;
  }

  .btn-danger {
    background: #cc0000;
    color: #fff;
  }

  .btn-danger:hover {
    background: #990000;
  }

  .btn-secondary {
    background: #f0f0f0;
    color: #333;
  }

  .btn-secondary:hover {
    background: #e0e0e0;
  }
</style>

<script>
  const form = document.getElementById('update-form') as HTMLFormElement;
  const closeBtn = document.getElementById('close-btn');
  const issueId = window.location.pathname.split('/').pop();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);

    try {
      const response = await fetch(`/api/issues/${issueId}/update`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          title: formData.get('title'),
          body: formData.get('body'),
          status: formData.get('status'),
          priority: formData.get('priority'),
        }),
      });

      if (!response.ok) {
        throw new Error('Failed to update issue');
      }

      alert('Issue updated successfully');
      window.location.reload();
    } catch (error) {
      alert('Failed to update issue');
    }
  });

  closeBtn?.addEventListener('click', async () => {
    if (!confirm('Close this issue?')) return;

    try {
      const response = await fetch(`/api/issues/${issueId}/close`, {
        method: 'POST',
      });

      if (!response.ok) {
        throw new Error('Failed to close issue');
      }

      window.location.href = '/';
    } catch (error) {
      alert('Failed to close issue');
    }
  });
</script>
