---
import Layout from '../../layouts/Layout.astro';
import IssueDetail from '../../components/IssueDetail.astro';
import { getIssue } from '../../../../shared/database';

// Require authentication
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

const { id } = Astro.params;

let issue: any = null;
let error: string | null = null;

try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db && id) {
    issue = await getIssue(db, Astro.locals.user.id, id);
    if (!issue) {
      error = 'Issue not found';
    }
  } else {
    error = 'Database binding not available';
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Unknown error';
}
---

<Layout title={issue ? issue.title : 'issue'}>
  {error && (
    <div class="error">{error}</div>
  )}

  {issue && (
    <IssueDetail
      issue={issue}
      showBeadsId={true}
      showGitContext={true}
      backLink={{ url: '/', label: 'back to issues' }}
    >
      <div class="actions-section">
        <form id="update-form" class="update-form">
          <div class="form-group">
            <label for="title">title</label>
            <input type="text" id="title" name="title" value={issue.title} required />
          </div>

          <div class="form-group">
            <label for="body">description</label>
            <textarea id="body" name="body" rows="5">{issue.body || ''}</textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="status">status</label>
              <select id="status" name="status">
                <option value="open" selected={issue.status === 'open'}>open</option>
                <option value="in_progress" selected={issue.status === 'in_progress'}>in progress</option>
                <option value="blocked" selected={issue.status === 'blocked'}>blocked</option>
                <option value="closed" selected={issue.status === 'closed'}>closed</option>
              </select>
            </div>

            <div class="form-group">
              <label for="priority">priority</label>
              <select id="priority" name="priority">
                <option value="0" selected={issue.priority === 0}>P0 - critical</option>
                <option value="1" selected={issue.priority === 1}>P1 - high</option>
                <option value="2" selected={issue.priority === 2}>P2 - normal</option>
                <option value="3" selected={issue.priority === 3}>P3 - low</option>
                <option value="4" selected={issue.priority === 4}>P4 - lowest</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="issue_type">type</label>
            <select id="issue_type" name="issue_type">
              <option value="task" selected={issue.issue_type === 'task'}>task</option>
              <option value="bug" selected={issue.issue_type === 'bug'}>bug</option>
              <option value="feature" selected={issue.issue_type === 'feature'}>feature</option>
              <option value="epic" selected={issue.issue_type === 'epic'}>epic</option>
              <option value="chore" selected={issue.issue_type === 'chore'}>chore</option>
            </select>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">update issue</button>
            <button type="button" class="btn btn-danger" id="close-btn">close issue</button>
            <a href="/" class="btn btn-secondary">cancel</a>
          </div>
        </form>
      </div>
    </IssueDetail>
  )}
</Layout>


<script>
  const form = document.getElementById('update-form') as HTMLFormElement;
  const closeBtn = document.getElementById('close-btn');
  const issueId = window.location.pathname.split('/').pop();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);

    try {
      const response = await fetch(`/api/issues/${issueId}/update`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          title: formData.get('title'),
          body: formData.get('body'),
          status: formData.get('status'),
          priority: parseInt(formData.get('priority') as string),
          issue_type: formData.get('issue_type'),
        }),
      });

      if (!response.ok) {
        throw new Error('Failed to update issue');
      }

      window.location.reload();
    } catch (error) {
      console.error('Failed to update issue:', error);
    }
  });

  closeBtn?.addEventListener('click', async () => {
    if (!confirm('Close this issue?')) return;

    try {
      const response = await fetch(`/api/issues/${issueId}/close`, {
        method: 'POST',
      });

      if (!response.ok) {
        throw new Error('Failed to close issue');
      }

      window.location.href = '/';
    } catch (error) {
      alert('Failed to close issue');
    }
  });
</script>
