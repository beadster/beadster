---
import Layout from '../../../layouts/Layout.astro';
import { fetchPublicBeads, fetchRepoInfo, checkRepoHasBeads } from '../../../lib/github';

const { owner, repo } = Astro.params;

if (!owner || !repo) {
  return Astro.redirect('/');
}

let issues: any[] = [];
let error: string | null = null;
let repoInfo: any = null;
let hasBeads = false;
let source: any = null;
let isAutoImported = false;

const user = Astro.locals.user;
const db = Astro.locals.runtime?.env?.DB;

try {
  // Check if repo has beads
  hasBeads = await checkRepoHasBeads(owner, repo);

  if (!hasBeads) {
    error = 'this repository does not use beads';
  } else {
    // Fetch repository info
    try {
      repoInfo = await fetchRepoInfo(owner, repo);
    } catch (e) {
      console.error('failed to fetch repo info:', e);
    }

    // If user is logged in, auto-import as mirror
    if (user && db) {
      const repoUrl = `https://github.com/${owner}/${repo}`;

      // Check if source already exists
      source = await db.prepare(`
        SELECT * FROM sources
        WHERE user_id = ? AND git_repo_url = ?
      `).bind(user.id, repoUrl).first();

      // Auto-import if not exists
      if (!source) {
        const sourceId = `src_${generateId()}`;
        const now = Date.now();

        await db.prepare(`
          INSERT INTO sources (
            id, user_id, name, type, git_repo_url, git_current_branch,
            is_mirror, auto_sync, sync_interval_minutes,
            last_sync, created_at, updated_at
          ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        `).bind(
          sourceId,
          user.id,
          `${owner}/${repo}`,
          'github-mirror',
          repoUrl,
          'main',
          1,  // is_mirror
          1,  // auto_sync enabled
          5,  // sync every 5 minutes
          now,  // last_sync (now since we're importing)
          now,
          now
        ).run();

        // Fetch and import issues
        const fetchedIssues = await fetchPublicBeads(owner, repo);

        for (const issue of fetchedIssues) {
          try {
            await importIssue(db, user.id, sourceId, issue);
          } catch (err) {
            console.error('failed to import issue:', issue.id, err);
          }
        }

        isAutoImported = true;

        // Re-fetch source to get the data
        source = await db.prepare(`
          SELECT * FROM sources WHERE id = ?
        `).bind(sourceId).first();
      }
    }

    // Fetch issues from beads for display
    issues = await fetchPublicBeads(owner, repo);
  }
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}

function generateId(): string {
  return Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15);
}

async function importIssue(db: any, userId: string, sourceId: string, issue: any) {
  const externalRef = issue.external_ref;

  // Check for existing by external_ref
  if (externalRef) {
    const existing = await db.prepare(`
      SELECT id FROM issues WHERE user_id = ? AND external_ref = ?
    `).bind(userId, externalRef).first();

    if (existing) return; // skip if exists
  }

  // Create new issue
  const issueId = `iss_${generateId()}`;
  await db.prepare(`
    INSERT INTO issues (
      id, user_id, source_id, beads_id, title, body, status, priority,
      issue_type, labels, external_ref, created_at, updated_at, closed_at
    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  `).bind(
    issueId,
    userId,
    sourceId,
    issue.id,
    issue.title,
    issue.body || issue.description || null,
    issue.status,
    issue.priority ?? 2,
    issue.issue_type || null,
    JSON.stringify(issue.labels || []),
    externalRef,
    parseTimestamp(issue.created_at),
    parseTimestamp(issue.updated_at),
    issue.closed_at ? parseTimestamp(issue.closed_at) : null
  ).run();
}

function parseTimestamp(dateStr: string | number): number {
  if (typeof dateStr === 'number') return dateStr;
  try {
    return Math.floor(new Date(dateStr).getTime());
  } catch {
    return Date.now();
  }
}

const openIssues = issues.filter(i => i.status !== 'closed');
const closedIssues = issues.filter(i => i.status === 'closed');

function formatDate(dateStr: string): string {
  try {
    const date = new Date(dateStr);
    return date.toLocaleDateString();
  } catch {
    return dateStr;
  }
}

function getPriorityLabel(priority?: number): string {
  if (priority === undefined || priority === null) return 'P2';
  return `P${priority}`;
}

function getStatusBadgeClass(status: string): string {
  switch (status) {
    case 'open': return 'status-open';
    case 'in_progress': return 'status-in-progress';
    case 'blocked': return 'status-blocked';
    case 'closed': return 'status-closed';
    default: return 'status-open';
  }
}

function getStatusLabel(status: string): string {
  switch (status) {
    case 'in_progress': return 'in progress';
    case 'blocked': return 'blocked';
    case 'closed': return 'closed';
    default: return 'open';
  }
}
---

<Layout title={`${owner}/${repo} - beadster`}>
  {/* Mirror badge at top */}
  {source && (
    <div class="mirror-banner">
      <span class="mirror-icon">🔄</span>
      <span>read-only mirror of <a href={`https://github.com/${owner}/${repo}`} target="_blank" rel="noopener">{owner}/{repo}</a></span>
      {source.last_sync && (
        <span class="sync-time">• syncs every {source.sync_interval_minutes}min • last: {new Date(source.last_sync).toLocaleString()}</span>
      )}
    </div>
  )}

  {!source && (
    <div class="repo-header">
      <h1><a href={`https://github.com/${owner}/${repo}`} target="_blank" rel="noopener">{owner}/{repo}</a></h1>
      {repoInfo && repoInfo.description && (
        <p class="repo-description">{repoInfo.description}</p>
      )}
    </div>
  )}

  {/* Tabs navigation */}
  <nav class="tabs">
    <a href={`/${owner}/${repo}`} class="active">open</a>
    <a href={`/${owner}/${repo}/closed`}>closed</a>
  </nav>

  {/* Header row */}
  <div class="header-row">
    <h2>open issues</h2>
  </div>

  {/* Error state */}
  {error && (
    <div class="error">
      <p>{error}</p>
      {error.includes('does not use beads') && (
        <p class="secondary-text mt-05">
          this repository doesn't have a .beads/ directory with issues (beads.jsonl or issues.jsonl)
        </p>
      )}
    </div>
  )}

  {/* Empty state */}
  {!error && issues.length === 0 && (
    <div class="empty">
      <p>no issues found in this repository</p>
    </div>
  )}

  {/* Issue list */}
  {!error && issues.length > 0 && (
    <ul class="issue-list">
      {openIssues.map(issue => (
        <li class="issue-item">
          <div class="issue-header">
            <div>
              <span class="issue-id">{issue.id}</span>
              <a href={`/${owner}/${repo}/${issue.id}`} class="issue-title">{issue.title}</a>
            </div>
          </div>
          <div class="issue-meta">
            <span class={`badge status ${issue.status}`}>{issue.status}</span>
            {issue.priority !== undefined && issue.priority !== null && (
              <span class="badge priority">P{issue.priority}</span>
            )}
            {issue.issue_type && (
              <span class="badge type-badge">{issue.issue_type}</span>
            )}
            {issue.labels && issue.labels.length > 0 && issue.labels.map((label: string) => (
              <span class="badge label-badge">{label}</span>
            ))}
            <span>created {formatDate(issue.created_at)}</span>
          </div>
          {issue.body && (
            <div class="issue-body">
              {issue.body.length > 200 ? issue.body.substring(0, 200) + '...' : issue.body}
            </div>
          )}
        </li>
      ))}
    </ul>
  )}

  {/* Auto-import notice */}
  {isAutoImported && (
    <div class="auto-import-notice">
      ✨ auto-imported to your account - view in <a href="/">your issues</a>
    </div>
  )}
</Layout>

<style>
  .mirror-banner {
    padding: 12px 15px;
    background: #e3f2fd;
    border: 1px solid #90caf9;
    border-radius: 6px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    flex-wrap: wrap;
  }

  .mirror-banner a {
    color: var(--primary-color);
    text-decoration: none;
    font-weight: 500;
  }

  .mirror-banner a:hover {
    text-decoration: underline;
  }

  .sync-time {
    color: #666;
    font-size: 13px;
  }

  .repo-header {
    margin-bottom: 20px;
  }

  .repo-header h1 {
    margin: 0;
    font-size: 24px;
  }

  .repo-header h1 a {
    color: inherit;
    text-decoration: none;
  }

  .repo-header h1 a:hover {
    text-decoration: underline;
  }

  .repo-description {
    margin: 8px 0 0 0;
    color: var(--text-secondary);
    font-size: 14px;
  }

  .auto-import-notice {
    margin-top: 20px;
    padding: 12px 15px;
    background: #e8f5e9;
    border: 1px solid #4caf50;
    border-radius: 6px;
    font-size: 14px;
    color: #2e7d32;
    text-align: center;
  }

  .auto-import-notice a {
    color: #2e7d32;
    font-weight: 500;
  }

  .type-badge {
    background: #e3f2fd;
    color: #1976d2;
  }

  .label-badge {
    background: #e8f5e9;
    color: #2e7d32;
  }

  .issue-body {
    margin-top: 8px;
    font-size: 14px;
    color: #666;
    line-height: 1.5;
  }
</style>
