---
import Layout from '../../../layouts/Layout.astro';
import { fetchPublicBeads, fetchRepoInfo, checkRepoHasBeads } from '../../../lib/github';

const { owner, repo } = Astro.params;

if (!owner || !repo) {
  return Astro.redirect('/');
}

let issues: any[] = [];
let error: string | null = null;
let repoInfo: any = null;
let hasBeads = false;
let source: any = null;
let isAutoImported = false;

const user = Astro.locals.user;
const db = Astro.locals.runtime?.env?.DB;

try {
  hasBeads = await checkRepoHasBeads(owner, repo);

  if (!hasBeads) {
    error = 'this repository does not use beads';
  } else {
    try {
      repoInfo = await fetchRepoInfo(owner, repo);
    } catch (e) {
      console.error('failed to fetch repo info:', e);
    }

    if (user && db) {
      const repoUrl = `https://github.com/${owner}/${repo}`;
      source = await db.prepare(`
        SELECT * FROM sources
        WHERE user_id = ? AND git_repo_url = ?
      `).bind(user.id, repoUrl).first();
    }

    issues = await fetchPublicBeads(owner, repo);
  }
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}

const openIssues = issues.filter(i => i.status !== 'closed');
const closedIssues = issues.filter(i => i.status === 'closed');

function formatDate(dateStr: string): string {
  try {
    const date = new Date(dateStr);
    return date.toLocaleDateString();
  } catch {
    return dateStr;
  }
}
---

<Layout title={`${owner}/${repo} - beadster`}>
  {source && (
    <div class="mirror-banner">
      <span class="mirror-icon">🔄</span>
      <span>read-only mirror of <a href={`https://github.com/${owner}/${repo}`} target="_blank" rel="noopener">{owner}/{repo}</a></span>
      {source.last_sync && (
        <span class="sync-time">• syncs every {source.sync_interval_minutes}min • last: {new Date(source.last_sync).toLocaleString()}</span>
      )}
    </div>
  )}

  {!source && (
    <div class="repo-header">
      <h1><a href={`https://github.com/${owner}/${repo}`} target="_blank" rel="noopener">{owner}/{repo}</a></h1>
      {repoInfo && repoInfo.description && (
        <p class="repo-description">{repoInfo.description}</p>
      )}
    </div>
  )}

  <nav class="tabs">
    <a href={`/${owner}/${repo}`}>open</a>
    <a href={`/${owner}/${repo}/closed`} class="active">closed</a>
  </nav>

  <div class="header-row">
    <h2>closed issues</h2>
  </div>

  {error && (
    <div class="error">
      <p>{error}</p>
      {error.includes('does not use beads') && (
        <p class="secondary-text mt-05">
          this repository doesn't have a .beads/ directory with issues (beads.jsonl or issues.jsonl)
        </p>
      )}
    </div>
  )}

  {!error && closedIssues.length === 0 && (
    <div class="empty">
      <p>no closed issues found</p>
    </div>
  )}

  {!error && closedIssues.length > 0 && (
    <ul class="issue-list">
      {closedIssues.map(issue => (
        <li class="issue-item">
          <div class="issue-header">
            <div>
              <span class="issue-id">{issue.id}</span>
              <a href={`/${owner}/${repo}/${issue.id}`} class="issue-title">{issue.title}</a>
            </div>
          </div>
          <div class="issue-meta">
            <span class={`badge status ${issue.status}`}>{issue.status}</span>
            {issue.priority !== undefined && issue.priority !== null && (
              <span class="badge priority">P{issue.priority}</span>
            )}
            {issue.issue_type && (
              <span class="badge type-badge">{issue.issue_type}</span>
            )}
            {issue.labels && issue.labels.length > 0 && issue.labels.map((label: string) => (
              <span class="badge label-badge">{label}</span>
            ))}
            <span>created {formatDate(issue.created_at)}</span>
          </div>
          {issue.body && (
            <div class="issue-body">
              {issue.body.length > 200 ? issue.body.substring(0, 200) + '...' : issue.body}
            </div>
          )}
        </li>
      ))}
    </ul>
  )}
</Layout>

<style>
  .mirror-banner {
    padding: 12px 15px;
    background: #e3f2fd;
    border: 1px solid #90caf9;
    border-radius: 6px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    flex-wrap: wrap;
  }

  .mirror-banner a {
    color: var(--primary-color);
    text-decoration: none;
    font-weight: 500;
  }

  .mirror-banner a:hover {
    text-decoration: underline;
  }

  .sync-time {
    color: #666;
    font-size: 13px;
  }

  .repo-header {
    margin-bottom: 20px;
  }

  .repo-header h1 {
    margin: 0;
    font-size: 24px;
  }

  .repo-header h1 a {
    color: inherit;
    text-decoration: none;
  }

  .repo-header h1 a:hover {
    text-decoration: underline;
  }

  .repo-description {
    margin: 8px 0 0 0;
    color: var(--text-secondary);
    font-size: 14px;
  }

  .type-badge {
    background: #e3f2fd;
    color: #1976d2;
  }

  .label-badge {
    background: #e8f5e9;
    color: #2e7d32;
  }

  .issue-body {
    margin-top: 8px;
    font-size: 14px;
    color: #666;
    line-height: 1.5;
  }
</style>
