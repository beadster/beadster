---
import Layout from '../../../layouts/Layout.astro';
import IssueDetail from '../../../components/IssueDetail.astro';
import { fetchPublicBeads } from '../../../lib/github';

const { owner, repo, id } = Astro.params;

if (!owner || !repo || !id) {
  return Astro.redirect('/');
}

let issue: any = null;
let error: string | null = null;

try {
  const issues = await fetchPublicBeads(owner, repo);
  issue = issues.find(i => i.id === id);

  if (!issue) {
    error = 'Issue not found';
  }
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
}
---

<Layout title={issue ? `${issue.id}: ${issue.title}` : 'Issue'}>
  {error && (
    <div class="error">{error}</div>
  )}

  {issue && (
    <IssueDetail
      issue={issue}
      isReadOnly={true}
      backLink={{ url: `/${owner}/${repo}`, label: `back to ${owner}/${repo}` }}
    >
      <div class="mirror-notice">
        <p>🔄 this is a read-only mirror from <a href={`https://github.com/${owner}/${repo}`} target="_blank" rel="noopener">{owner}/{repo}</a></p>
        <p class="secondary-text-sm">
          to edit this issue, visit the source repository on GitHub
        </p>
      </div>
    </IssueDetail>
  )}
</Layout>

<style>
  .mirror-notice {
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    background: var(--color-primary-light);
    border: 1px solid var(--color-primary);
    border-radius: var(--border-radius);
    text-align: center;
  }

  .mirror-notice p {
    margin: 0;
  }

  .mirror-notice a {
    color: var(--color-primary);
    font-weight: 500;
  }
</style>
