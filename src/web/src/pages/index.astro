---
import Layout from '../layouts/Layout.astro';
import { getIssues } from '../../../shared/database';

const user = Astro.locals.user;

let issues: any[] = [];
let error: string | null = null;

// Get query parameters for filtering
const repoUrl = Astro.url.searchParams.get('repo');
const issueType = Astro.url.searchParams.get('type');
const assignee = Astro.url.searchParams.get('assignee');
const search = Astro.url.searchParams.get('search');

// Get open issues using shared database module
if (user) {
  try {
    const db = Astro.locals.runtime?.env?.DB;

    if (db) {
      const filters: any = { status: 'open' };
      if (repoUrl) filters.git_repo_url = repoUrl;
      if (issueType) filters.issue_type = issueType;
      if (assignee) filters.assignee = assignee;
      if (search) filters.search = search;

      issues = await getIssues(db, user.id, filters);
    } else {
      error = 'Database binding not available';
    }
  } catch (e) {
    error = `Failed to fetch: ${e instanceof Error ? e.message : String(e)}`;
  }
}

function formatDate(timestamp: number): string {
  return new Date(timestamp * 1000).toLocaleDateString();
}

function getPriorityClass(priority: number | null): string {
  if (priority === null) return '';
  if (priority === 0) return 'priority';
  if (priority === 1) return 'priority p1';
  return 'priority p2';
}

function getRepoName(url: string): string {
  // Extract repo name from git URL
  try {
    const match = url.match(/([^/:]+\/[^/:]+?)(\.git)?$/);
    return match ? match[1] : url;
  } catch {
    return url;
  }
}

function parseExternalRef(ref: string | null): { platform: string; repoPath?: string; id: string; url?: string } | null {
  if (!ref) return null;

  // github:owner/repo:issue-id
  const githubMatch = ref.match(/^github:([^:]+):(.+)$/);
  if (githubMatch) {
    return {
      platform: 'GitHub',
      repoPath: githubMatch[1],
      id: githubMatch[2],
      url: `https://github.com/${githubMatch[1]}`
    };
  }

  // jira:PROJECT-123
  const jiraMatch = ref.match(/^jira:(.+)$/);
  if (jiraMatch) {
    return { platform: 'Jira', id: jiraMatch[1] };
  }

  // linear:abc-123
  const linearMatch = ref.match(/^linear:(.+)$/);
  if (linearMatch) {
    return { platform: 'Linear', id: linearMatch[1] };
  }

  return { platform: 'External', id: ref };
}

const hasFilters = repoUrl || issueType || assignee || search;
---

<Layout title={user ? "issues" : "beadster - local-first issue tracker"}>
  {!user ? (
    <>
      <h1>beadster</h1>
      <p>local-first issue tracker for developers based on <a href="https://github.com/steveyegge/beads" class="text-link">beads</a>.</p>

      <h2>features</h2>
      <ul>
        <li>macOS native app</li>
        <li>iOS native app (coming soon)</li>
        <li>works with bd CLI tool</li>
        <li>optional cloud sync across devices</li>
        <li>GitHub integration - browse and import</li>
      </ul>

      <p style="margin-top:1rem;">
        <a href="/login" class="btn-primary">sign in with github</a>
      </p>

      <p style="margin-top:1rem;">
        <a href="/steveyegge/beads" class="text-link">browse public GitHub repos with beads →</a>
      </p>

      <p style="margin-top:0.5rem;">
        <a href="/settings/import" class="text-link">import private GitHub repos →</a>
      </p>

      <p style="margin-top:2rem; color: #666;">
        download: <a href="https://apps.apple.com/us/app/beadster-issue-tracking/id6754286462?mt=12">macOS app</a>
      </p>
    </>
  ) : (
    <>
      <nav class="tabs">
        <a href="/" class={!hasFilters ? "active" : ""}>open</a>
        <a href="/all">all</a>
        <a href="/closed">closed</a>
        <a href="/labels">labels</a>
        <a href="/tree">tree</a>
        <a href="/repositories">repositories</a>
        <a href="/stats">stats</a>
      </nav>

      <div class="header-row">
        <h2>open issues</h2>
        <div style="display: flex; gap: 10px; align-items: center;">
          {hasFilters && (
            <a href="/" class="btn-clear-filter">× clear filters</a>
          )}
          <a href="/new" class="btn-new">+ new issue</a>
        </div>
      </div>

      <!-- Filters Bar -->
      <form class="filters-bar" method="get">
        <input
          type="search"
          name="search"
          placeholder="search title or body..."
          value={search || ''}
          class="filter-search"
        />

        <select name="type" class="filter-select">
          <option value="">all types</option>
          <option value="bug" selected={issueType === 'bug'}>bug</option>
          <option value="feature" selected={issueType === 'feature'}>feature</option>
          <option value="task" selected={issueType === 'task'}>task</option>
          <option value="epic" selected={issueType === 'epic'}>epic</option>
          <option value="chore" selected={issueType === 'chore'}>chore</option>
        </select>

        <select name="assignee" class="filter-select">
          <option value="">all assignees</option>
          <option value="@me" selected={assignee === '@me'}>assigned to me</option>
          <option value="unassigned" selected={assignee === 'unassigned'}>unassigned</option>
        </select>

        {repoUrl && <input type="hidden" name="repo" value={repoUrl} />}

        <button type="submit" class="btn-filter">apply</button>
      </form>

      {error && (
        <div class="error">
          <p>{error}</p>
        </div>
      )}

      {!error && issues.length === 0 && (
        <div class="empty">
          <p>{hasFilters ? 'no issues match your filters' : 'no issues yet'}</p>
        </div>
      )}

      {!error && issues.length > 0 && (
    <ul class="issue-list">
      {issues.map(issue => {
        const externalRef = parseExternalRef(issue.external_ref);
        return (
        <li class="issue-item">
          <div class="issue-header">
            <div>
              <span class="issue-id">{issue.beads_id}</span>
              <a href={`/issues/${issue.id}`} class="issue-title">{issue.title}</a>
            </div>
            <div class="issue-actions">
              <button class="btn-close" data-id={issue.id}>✓ close</button>
            </div>
          </div>
          <div class="issue-meta">
            <span class={`badge status ${issue.status}`}>{issue.status}</span>
            {issue.priority !== null && (
              <span class={`badge ${getPriorityClass(issue.priority)}`}>
                P{issue.priority}
              </span>
            )}
            {issue.issue_type && (
              <span class="badge type-badge">{issue.issue_type}</span>
            )}
            {externalRef && (
              <a
                href={externalRef.url || '#'}
                class="badge external-ref-badge"
                target={externalRef.url ? '_blank' : undefined}
                rel={externalRef.url ? 'noopener' : undefined}
                title={issue.external_ref}
              >
                {externalRef.platform}: {externalRef.id}
              </a>
            )}
            {issue.git_repo_url && (
              <a href={`/?repo=${encodeURIComponent(issue.git_repo_url)}`} class="badge repo-badge">
                📦 {getRepoName(issue.git_repo_url)}
              </a>
            )}
            {issue.assignee && (
              <span class="badge assignee-badge">@{issue.assignee}</span>
            )}
            {issue.git_branch && (
              <span class="badge branch-badge">🌿 {issue.git_branch}</span>
            )}
            <span>created {formatDate(issue.created_at)}</span>
          </div>
          {issue.body && (
            <div class="issue-body">
              {issue.body.length > 200 ? issue.body.substring(0, 200) + '...' : issue.body}
            </div>
          )}
        </li>
        );
      })}
    </ul>
      )}
    </>
  )}
</Layout>

<style>
  .filters-bar {
    display: flex;
    gap: 8px;
    margin: 10px 0;
    align-items: center;
  }

  .filter-search {
    flex: 1;
    min-width: 200px;
    padding: 6px 10px;
    border: 1px solid var(--color-border, #ddd);
    border-radius: var(--border-radius);
    font-size: var(--font-base);
  }

  .filter-select {
    padding: 6px 10px;
    border: 1px solid var(--color-border, #ddd);
    border-radius: var(--border-radius);
    font-size: var(--font-base);
    background: white;
    cursor: pointer;
  }

  .btn-filter {
    padding: 6px 16px;
    background: var(--color-primary, #0066cc);
    color: white;
    border: none;
    border-radius: var(--border-radius);
    font-size: var(--font-base);
    cursor: pointer;
  }

  .btn-filter:hover {
    opacity: 0.9;
  }

  .issue-body {
    margin-top: 8px;
    font-size: 14px;
    color: #666;
    line-height: 1.5;
  }

  .type-badge {
    background: #e3f2fd;
    color: #1976d2;
  }

  .external-ref-badge {
    background: #f3e5f5;
    color: #7b1fa2;
    text-decoration: none;
    cursor: pointer;
  }

  .external-ref-badge:hover {
    background: #e1bee7;
  }

  .repo-badge {
    background: #e8f5e9;
    color: #2e7d32;
    text-decoration: none;
  }

  .repo-badge:hover {
    background: #c8e6c9;
  }

  .assignee-badge {
    background: #fff3e0;
    color: #f57c00;
  }

  .branch-badge {
    background: #fce4ec;
    color: #c2185b;
    font-size: 12px;
  }

  .btn-clear-filter {
    padding: 8px 15px;
    background: #f5f5f5;
    color: #666;
    text-decoration: none;
    border-radius: 4px;
    font-size: 14px;
  }

  .btn-clear-filter:hover {
    background: #e0e0e0;
  }
</style>

{user && (
<script>
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    if (target.classList.contains('btn-close')) {
      const id = target.dataset.id;
      if (!id) return;

      if (!confirm('Close this issue?')) return;

      try {
        const response = await fetch(`/api/issues/${id}/close`, {
          method: 'POST'
        });

        if (!response.ok) {
          throw new Error('Failed to close issue');
        }

        window.location.reload();
      } catch (err) {
        alert('Failed to close issue');
      }
    }
  });
</script>
)}
