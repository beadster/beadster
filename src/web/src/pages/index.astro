---
import Layout from '../layouts/Layout.astro';
import { getIssues } from '../../../shared/database';

let issues: any[] = [];
let error: string | null = null;

// Get query parameters
const repoUrl = Astro.url.searchParams.get('repo');

// Get open issues using shared database module
try {
  const db = Astro.locals.runtime?.env?.DB;
  const user = Astro.locals.user;

  if (db && user) {
    const filters: any = { status: 'open' };
    if (repoUrl) {
      filters.git_repo_url = repoUrl;
    }
    issues = await getIssues(db, user.id, filters);
  } else if (!user) {
    error = 'Not logged in - sign in to see your issues';
  } else {
    error = 'Database binding not available';
  }
} catch (e) {
  error = `Failed to fetch: ${e instanceof Error ? e.message : String(e)}`;
}

function formatDate(timestamp: number): string {
  return new Date(timestamp * 1000).toLocaleDateString();
}

function getPriorityClass(priority: number | null): string {
  if (priority === null) return '';
  if (priority === 0) return 'priority';
  if (priority === 1) return 'priority p1';
  return 'priority p2';
}

function getRepoName(url: string): string {
  // Extract repo name from git URL
  try {
    const match = url.match(/([^/:]+\/[^/:]+?)(\.git)?$/);
    return match ? match[1] : url;
  } catch {
    return url;
  }
}
---

<Layout title="issues">
  <nav class="tabs">
    <a href="/" class={!repoUrl ? "active" : ""}>open</a>
    <a href="/all">all</a>
    <a href="/closed">closed</a>
    <a href="/labels">labels</a>
    <a href="/tree">tree</a>
    <a href="/repositories">repositories</a>
    <a href="/stats">stats</a>
  </nav>

  <div class="header-row">
    <h2>
      {repoUrl ? `${getRepoName(repoUrl)} - open issues` : 'open issues'}
    </h2>
    <div style="display: flex; gap: 10px; align-items: center;">
      {repoUrl && (
        <a href="/" class="btn-clear-filter">× clear filter</a>
      )}
      <a href="/new" class="btn-new">+ new issue</a>
    </div>
  </div>

  {error && (
    <div class="error">
      <p>{error}</p>
      <p style="font-size: 14px; color: #666; margin-top: 10px;">
        configure BEADSTER_API_URL environment variable or update src/pages/index.astro
      </p>
    </div>
  )}

  {!error && issues.length === 0 && (
    <div class="empty">
      <p>no issues yet</p>
    </div>
  )}

  {!error && issues.length > 0 && (
    <ul class="issue-list">
      {issues.map(issue => (
        <li class="issue-item">
          <div class="issue-header">
            <div>
              <span class="issue-id">{issue.beads_id}</span>
              <a href={`/issues/${issue.id}`} class="issue-title">{issue.title}</a>
            </div>
            <div class="issue-actions">
              <button class="btn-close" data-id={issue.id}>✓ close</button>
            </div>
          </div>
          <div class="issue-meta">
            <span class={`badge status ${issue.status}`}>{issue.status}</span>
            {issue.priority !== null && (
              <span class={`badge ${getPriorityClass(issue.priority)}`}>
                P{issue.priority}
              </span>
            )}
            {issue.session_id && (
              <span class="badge session">
                {issue.session_id.substring(0, 20)}...
              </span>
            )}
            {issue.client && (
              <span class="badge client">{issue.client}</span>
            )}
            {issue.project_name && (
              <span class="badge">{issue.project_name}</span>
            )}
            <span>created {formatDate(issue.created_at)}</span>
          </div>
          {issue.body && (
            <div style="margin-top: 8px; font-size: 14px; color: #666;">
              {issue.body}
            </div>
          )}
        </li>
      ))}
    </ul>
  )}
</Layout>


<script>
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    if (target.classList.contains('btn-close')) {
      const id = target.dataset.id;
      if (!id) return;

      if (!confirm('Close this issue?')) return;

      try {
        const response = await fetch(`/api/issues/${id}/close`, {
          method: 'POST'
        });

        if (!response.ok) {
          throw new Error('Failed to close issue');
        }

        window.location.reload();
      } catch (err) {
        alert('Failed to close issue');
      }
    }
  });
</script>
