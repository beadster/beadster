---
import Layout from '../layouts/Layout.astro';
import TabNav from '../components/TabNav.astro';
import IssueListItem from '../components/IssueListItem.astro';
import { getIssues } from '../../../shared/database';

const user = Astro.locals.user;

let issues: any[] = [];
let error: string | null = null;

// Get query parameters for filtering
const repoUrl = Astro.url.searchParams.get('repo');
const issueType = Astro.url.searchParams.get('type');
const assignee = Astro.url.searchParams.get('assignee');
const search = Astro.url.searchParams.get('search');

// Get open issues using shared database module
if (user) {
  try {
    const db = Astro.locals.runtime?.env?.DB;

    if (db) {
      const filters: any = { status: 'open' };
      if (repoUrl) filters.git_repo_url = repoUrl;
      if (issueType) filters.issue_type = issueType;
      if (assignee) filters.assignee = assignee;
      if (search) filters.search = search;

      issues = await getIssues(db, user.id, filters);
    } else {
      error = 'Database binding not available';
    }
  } catch (e) {
    error = `Failed to fetch: ${e instanceof Error ? e.message : String(e)}`;
  }
}

const hasFilters = repoUrl || issueType || assignee || search;
---

<Layout title={user ? "issues" : "beadster - local-first issue tracker"}>
  {!user ? (
    <>
      <h1>beadster</h1>
      <p>local-first issue tracker for developers based on <a href="https://github.com/steveyegge/beads" class="text-link">beads</a>.</p>

      <h2>features</h2>
      <ul>
        <li>macOS native app</li>
        <li>iOS native app (coming soon)</li>
        <li>works with bd CLI tool</li>
        <li>optional cloud sync across devices</li>
        <li>GitHub integration - browse and import</li>
      </ul>

      <p class="mt-1">
        <a href="/login" class="btn-primary">sign in with github</a>
      </p>

      <p class="mt-1">
        <a href="/steveyegge/beads" class="text-link">browse public GitHub repos with beads →</a>
      </p>

      <p class="mt-05">
        <a href="/settings/import" class="text-link">import private GitHub repos →</a>
      </p>

      <p class="secondary-text mt-2">
        download: <a href="https://apps.apple.com/us/app/beadster-issue-tracking/id6754286462?mt=12">macOS app</a>
      </p>
    </>
  ) : (
    <>
      <TabNav active="open" />

      <div class="header-row">
        <h2>open issues</h2>
        <div class="flex-header-actions">
          {hasFilters && (
            <a href="/" class="btn-clear-filter">× clear filters</a>
          )}
          <a href="/new" class="btn-new">+ new issue</a>
        </div>
      </div>

      <!-- Filters Bar -->
      <form class="filters-bar" method="get">
        <input
          type="search"
          name="search"
          placeholder="search title or body..."
          value={search || ''}
          class="filter-search"
        />

        <select name="type" class="filter-select">
          <option value="">all types</option>
          <option value="bug" selected={issueType === 'bug'}>bug</option>
          <option value="feature" selected={issueType === 'feature'}>feature</option>
          <option value="task" selected={issueType === 'task'}>task</option>
          <option value="epic" selected={issueType === 'epic'}>epic</option>
          <option value="chore" selected={issueType === 'chore'}>chore</option>
        </select>

        <select name="assignee" class="filter-select">
          <option value="">all assignees</option>
          <option value="@me" selected={assignee === '@me'}>assigned to me</option>
          <option value="unassigned" selected={assignee === 'unassigned'}>unassigned</option>
        </select>

        {repoUrl && <input type="hidden" name="repo" value={repoUrl} />}

        <button type="submit" class="btn-filter">apply</button>
      </form>

      {error && (
        <div class="error">
          <p>{error}</p>
        </div>
      )}

      {!error && issues.length === 0 && (
        <div class="empty">
          <p>{hasFilters ? 'no issues match your filters' : 'no issues yet'}</p>
        </div>
      )}

      {!error && issues.length > 0 && (
        <ul class="issue-list">
          {issues.map(issue => (
            <IssueListItem issue={issue} showCloseButton={true} />
          ))}
        </ul>
      )}
    </>
  )}
</Layout>

<style>
  .filters-bar {
    display: flex;
    gap: var(--space-sm);
    margin: var(--space-md) 0;
    align-items: center;
  }

  .filter-search {
    flex: 1;
    min-width: 200px;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--border-radius);
    font-size: var(--font-base);
  }

  .filter-select {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--border-radius);
    font-size: var(--font-base);
    background: var(--color-bg);
    cursor: pointer;
  }

  .btn-filter {
    padding: var(--space-sm) var(--space-xl);
    background: var(--color-primary);
    color: white;
    border: none;
    border-radius: var(--border-radius);
    font-size: var(--font-base);
    cursor: pointer;
  }

  .btn-filter:hover {
    background: var(--color-primary-hover);
  }
</style>

{user && (
<script>
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    if (target.classList.contains('btn-close')) {
      const id = target.dataset.id;
      if (!id) return;

      if (!confirm('Close this issue?')) return;

      try {
        const response = await fetch(`/api/issues/${id}/close`, {
          method: 'POST'
        });

        if (!response.ok) {
          throw new Error('Failed to close issue');
        }

        window.location.reload();
      } catch (err) {
        alert('Failed to close issue');
      }
    }
  });
</script>
)}
