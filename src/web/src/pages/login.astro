---
import Layout from '../layouts/Layout.astro';

// Redirect if already logged in
if (Astro.locals.user) {
  const returnUrl = Astro.url.searchParams.get('return') || '/';
  return Astro.redirect(returnUrl);
}

const returnUrl = Astro.url.searchParams.get('return') || '/';
---

<Layout title="Sign In">
  <div class="login-container">
    <h1>beadster</h1>
    <p>issue tracker for AI agents and developers</p>

    <button id="github-signin-btn" class="btn-github">
      sign in with github
    </button>
  </div>

  <script define:vars={{ returnUrl }}>
    document.getElementById('github-signin-btn').addEventListener('click', async () => {
      const response = await fetch('/api/auth/sign-in/social', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          provider: 'github',
          callbackURL: returnUrl
        })
      });

      if (response.ok) {
        const data = await response.json();
        if (data.url) {
          window.location.href = data.url;
        }
      }
    });
  </script>
</Layout>
