---
import Layout from '../layouts/Layout.astro';
import TabNav from '../components/TabNav.astro';
import IssueListItem from '../components/IssueListItem.astro';
import { getIssues } from '../../../shared/database';

// Require authentication
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

let issues: any[] = [];
let error: string | null = null;

// Get all issues for this user (not global!)
try {
  const db = Astro.locals.runtime?.env?.DB;
  if (db) {
    issues = await getIssues(db, Astro.locals.user.id);
  } else {
    error = 'Database binding not available';
  }
} catch (e) {
  error = `Failed to fetch: ${e instanceof Error ? e.message : String(e)}`;
}
---

<Layout title="issues">
  <TabNav active="all" />

  <h2>all issues</h2>

  {error && (
    <div class="error">
      <p>{error}</p>
    </div>
  )}

  {!error && issues.length === 0 && (
    <div class="empty">
      <p>no issues yet</p>
    </div>
  )}

  {!error && issues.length > 0 && (
    <ul class="issue-list">
      {issues.map(issue => (
        <IssueListItem
          issue={issue}
          showSessionInfo={true}
          showGitInfo={false}
          showExternalRef={false}
        />
      ))}
    </ul>
  )}
</Layout>

