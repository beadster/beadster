---
import Layout from '../../layouts/Layout.astro';

if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

const db = Astro.locals.runtime?.env?.DB;
let hasGitHubToken = false;
let error: string | null = null;

// Check if user has GitHub OAuth token
if (db) {
  try {
    const account = await db.prepare(`
      SELECT access_token FROM accounts
      WHERE user_id = ? AND provider_id = 'github'
      AND access_token IS NOT NULL
    `).bind(Astro.locals.user.id).first();

    hasGitHubToken = !!account;
  } catch (e) {
    error = `Failed to check GitHub connection: ${e instanceof Error ? e.message : String(e)}`;
  }
}
---

<Layout title="import private repositories">
  <nav class="tabs">
    <a href="/">open</a>
    <a href="/settings/tokens">tokens</a>
    <a href="/settings/import" class="active">import</a>
  </nav>

  <div class="page-header">
    <h2>import private repositories</h2>
  </div>

  <div class="description">
    import issues from your private GitHub repositories that use beads
  </div>

  {error && (
    <div class="error">{error}</div>
  )}

  {!hasGitHubToken ? (
    <div class="connect-github">
      <div class="info-box">
        <h3>🔒 GitHub access required</h3>
        <p>to import private repositories, you need to reconnect your GitHub account with repository access.</p>
        <p>we'll use your GitHub token to:</p>
        <ul>
          <li>access your private repositories</li>
          <li>read .beads/issues.jsonl files</li>
          <li>import issues to beadster</li>
        </ul>
        <p><strong>note:</strong> if you previously signed in, you'll need to sign out and sign in again to grant repository access.</p>
      </div>

      <div class="connect-actions">
        <a href="/api/auth/sign-out" class="btn-secondary">sign out first</a>
        <p style="margin: 10px 0; color: #666;">then sign in again to grant access</p>
      </div>
    </div>
  ) : (
    <div class="import-section">
      <div class="success-box">
        <p>✅ GitHub connected with repository access</p>
      </div>

      <form id="importForm" class="import-form">
        <div class="form-group">
          <label for="repoUrl">GitHub repository URL</label>
          <input
            type="text"
            id="repoUrl"
            name="repoUrl"
            placeholder="https://github.com/owner/repo"
            required
          />
          <small>paste the URL of your private repository</small>
        </div>

        <div class="form-group">
          <label for="branch">branch (optional)</label>
          <input
            type="text"
            id="branch"
            name="branch"
            value="main"
          />
          <small>which branch to import from</small>
        </div>

        <button type="submit" class="btn-primary">import private repository</button>
      </form>

      <div id="importResult" class="import-result" style="display: none;"></div>

      <div class="help-section">
        <h3>how it works</h3>
        <ul>
          <li>we use your GitHub token to access the private repository</li>
          <li>we fetch .beads/issues.jsonl from the repository</li>
          <li>issues are imported to your beadster account</li>
          <li>duplicates are detected by external_ref</li>
          <li>you can re-import to sync updates</li>
        </ul>
      </div>

      <div class="public-repos-note">
        <p>💡 <strong>tip:</strong> for public repositories, you don't need to use this page. just visit:</p>
        <p><code>beadster.ai/github/owner/repo</code></p>
        <p>and click "import to my account"</p>
      </div>
    </div>
  )}
</Layout>

<style>
  .page-header {
    margin-bottom: 10px;
  }

  .description {
    margin-bottom: 30px;
    color: var(--text-secondary);
  }

  .connect-github {
    max-width: 600px;
  }

  .info-box {
    background: #e3f2fd;
    border: 1px solid #90caf9;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
  }

  .info-box h3 {
    margin: 0 0 15px 0;
    color: #1976d2;
  }

  .info-box p {
    margin: 10px 0;
    line-height: 1.6;
  }

  .info-box ul {
    margin: 10px 0;
    padding-left: 20px;
  }

  .info-box li {
    margin: 5px 0;
  }

  .connect-actions {
    text-align: center;
  }

  .success-box {
    background: #e8f5e9;
    border: 1px solid #4caf50;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 30px;
  }

  .success-box p {
    margin: 0;
    color: #2e7d32;
  }

  .import-form {
    max-width: 600px;
    margin-bottom: 30px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: 500;
  }

  .form-group input {
    width: 100%;
    padding: 10px;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    font-size: 14px;
  }

  .form-group small {
    display: block;
    margin-top: 5px;
    color: var(--text-secondary);
    font-size: 12px;
  }

  .btn-primary, .btn-secondary {
    padding: 10px 20px;
    border-radius: 4px;
    font-size: 14px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    border: none;
  }

  .btn-primary {
    background: var(--primary-color);
    color: white;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-secondary {
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .btn-secondary:hover {
    background: var(--border-color);
  }

  .import-result {
    margin-top: 20px;
    padding: 15px;
    border-radius: 8px;
  }

  .import-result.success {
    background: #e8f5e9;
    border: 1px solid #4caf50;
    color: #2e7d32;
  }

  .import-result.error {
    background: #ffebee;
    border: 1px solid #f44336;
    color: #c62828;
  }

  .help-section {
    margin-top: 40px;
    padding: 20px;
    background: var(--bg-secondary);
    border-radius: 8px;
  }

  .help-section h3 {
    margin-top: 0;
  }

  .help-section ul {
    margin: 0;
    padding-left: 20px;
  }

  .help-section li {
    margin: 8px 0;
  }

  .public-repos-note {
    margin-top: 30px;
    padding: 15px;
    background: #fff3e0;
    border: 1px solid #ffb74d;
    border-radius: 8px;
  }

  .public-repos-note p {
    margin: 5px 0;
  }

  .public-repos-note code {
    background: white;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 13px;
  }

  .error {
    padding: 15px;
    background: #ffebee;
    border: 1px solid #f44336;
    color: #c62828;
    border-radius: 8px;
    margin-bottom: 20px;
  }

  .tabs {
    display: flex;
    gap: 20px;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 30px;
  }

  .tabs a {
    padding: 10px 15px;
    text-decoration: none;
    color: var(--text-secondary);
    border-bottom: 2px solid transparent;
  }

  .tabs a:hover {
    color: var(--text-primary);
  }

  .tabs a.active {
    color: var(--primary-color);
    border-bottom-color: var(--primary-color);
  }
</style>

<script>
  const form = document.getElementById('importForm') as HTMLFormElement;
  const result = document.getElementById('importResult') as HTMLElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const repoUrl = formData.get('repoUrl') as string;
    const branch = formData.get('branch') as string || 'main';

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = 'importing...';

    result.style.display = 'none';

    try {
      const response = await fetch('/api/import/github-private', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ repo_url: repoUrl, branch })
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.error || 'import failed');
      }

      result.className = 'import-result success';
      result.style.display = 'block';
      result.innerHTML = `
        <h3>✅ import successful!</h3>
        <p>imported ${data.total} issues:</p>
        <ul>
          <li>${data.created} created</li>
          <li>${data.updated} updated</li>
          <li>${data.skipped} skipped (no changes)</li>
        </ul>
        <p><a href="/">view imported issues →</a></p>
      `;

      form.reset();
    } catch (err) {
      result.className = 'import-result error';
      result.style.display = 'block';
      result.innerHTML = `
        <h3>❌ import failed</h3>
        <p>${(err as Error).message}</p>
      `;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'import private repository';
    }
  });
</script>
