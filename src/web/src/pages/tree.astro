---
import Layout from '../layouts/Layout.astro';
import TabNav from '../components/TabNav.astro';

// Require authentication
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}
---

<Layout title="tree">
  <TabNav active="tree" />

  <h2>dependency tree</h2>

  <div class="notice">
    <h3>Coming Soon</h3>
    <p>
      Dependency tree visualization will be available once dependencies are synced to the cloud.
    </p>
    <p>
      For now, use the local bd CLI to view dependencies:
    </p>
    <pre><code>bd dep tree</code></pre>
  </div>
</Layout>

