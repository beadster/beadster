---
import Layout from '../layouts/Layout.astro';
import TabNav from '../components/TabNav.astro';
import StatCard from '../components/StatCard.astro';
import ChartSection from '../components/ChartSection.astro';
import { getUserStats } from '../../../shared/database';

// Require authentication
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

interface Stats {
  total_issues: number;
  open_issues: number;
  closed_issues: number;
  total_sources: number;
  total_sessions: number;
  issues_by_priority: { priority: number; count: number }[];
  issues_by_source: { source_name: string; count: number }[];
  recent_activity: { date: string; count: number }[];
}

let stats: Partial<Stats> = {};
let error: string | null = null;

try {
  const db = Astro.locals.runtime?.env?.DB;
  if (!db) {
    error = 'Database binding not available';
  } else {
    stats = await getUserStats(db, Astro.locals.user.id);
  }
} catch (e) {
  error = `Failed to fetch stats: ${e instanceof Error ? e.message : String(e)}`;
}

const completionRate = stats.closed_issues && stats.total_issues
  ? Math.round((stats.closed_issues / stats.total_issues) * 100)
  : 0;
---

<Layout title="stats">
  <TabNav active="stats" />

  <h2>statistics</h2>

  {error && (
    <div class="error">{error}</div>
  )}

  {!error && (
    <>
      <div class="stats-grid">
        <StatCard value={stats.total_issues || 0} label="total issues" />
        <StatCard value={stats.open_issues || 0} label="open issues" />
        <StatCard value={stats.closed_issues || 0} label="closed issues" />
        <StatCard value={stats.total_sources || 0} label="sources" />
        <StatCard value={stats.total_sessions || 0} label="sessions" />
        <StatCard value={`${completionRate}%`} label="completion rate" />
      </div>

      <div class="charts">
        {stats.issues_by_priority && stats.issues_by_priority.length > 0 && (
          <ChartSection
            title="issues by priority"
            items={stats.issues_by_priority.map(item => ({
              label: `P${item.priority}`,
              value: item.count
            }))}
            maxValue={stats.total_issues}
          />
        )}

        {stats.issues_by_source && stats.issues_by_source.length > 0 && (
          <ChartSection
            title="issues by source"
            items={stats.issues_by_source.map(item => ({
              label: item.source_name,
              value: item.count
            }))}
            maxValue={stats.total_issues}
          />
        )}

        {stats.recent_activity && stats.recent_activity.length > 0 && (
          <ChartSection
            title="recent activity (last 7 days)"
            items={stats.recent_activity.map(item => ({
              label: new Date(item.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
              value: item.count
            }))}
          />
        )}
      </div>
    </>
  )}
</Layout>
