---
import HamburgerMenu from "../components/HamburgerMenu.astro";
import Logo from "../components/Logo.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title} - beadster</title>
        <style is:global>
            :root {
                /* colors */
                --color-primary: #0066cc;
                --color-text: #333;
                --color-text-light: #666;
                --color-text-lighter: #999;
                --color-bg: white;
                --color-bg-light: #f9f9f9;
                --color-border: #eee;
                --color-border-dark: #ddd;

                /* status colors */
                --color-success: #060;
                --color-success-bg: #e8ffe8;
                --color-success-dark: #006600;
                --color-success-hover: #d0ffd0;
                --color-error: #c00;
                --color-error-bg: #fee;
                --color-error-dark: #cc0000;
                --color-error-darker: #990000;
                --color-warning: #880;
                --color-warning-bg: #ffe;

                /* additional colors */
                --color-primary-hover: #0052a3;
                --color-primary-light: #e8f4ff;
                --color-primary-lighter: #f5f9ff;
                --color-github: #24292e;
                --color-neutral: #f0f0f0;
                --color-neutral-dark: #e0e0e0;
                --color-neutral-text: #555;
                --color-purple: #660099;
                --color-purple-bg: #f5e6ff;

                /* fonts */
                --font-sans:
                    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                    sans-serif;
                --font-mono: monospace;

                /* font sizes */
                --font-xs: 10px;
                --font-sm: 11px;
                --font-md: 13px;
                --font-base: 14px;
                --font-lg: 16px;
                --font-xl: 20px;
                --font-2xl: 24px;

                /* spacing - compact design */
                --space-xs: 2px;
                --space-sm: 4px;
                --space-md: 8px;
                --space-lg: 12px;
                --space-xl: 16px;

                /* sizes */
                --border-radius: 4px;
                --border-radius-sm: 2px;
                --max-width: 540px;

                /* component-specific */
                --bar-bg: #e0e0e0;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                font-size: var(--font-base);
                font-family: var(--font-sans);
                line-height: 1.4;
                color: var(--color-text);
                background: var(--color-bg);
                height: 100%;
            }

            body {
                font-family: var(--font-sans);
                line-height: 1.4;
                color: var(--color-text);
                background: var(--color-bg);
                min-height: 100%;
                display: flex;
                flex-direction: column;
                overflow-x: hidden;
                overflow-y: scroll;
            }

            main {
                flex: 1;
                width: 100%;
            }

            header {
                width: 100%;
            }

            .header-wrapper {
                max-width: var(--max-width);
                margin: 0 auto;
                padding: 0.5rem 1rem;
                width: 100%;
                position: relative;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .logo-link {
                display: flex;
                align-items: center;
                text-decoration: none;
                line-height: 0;
            }

            .logo-link:hover {
                opacity: 0.8;
            }

            .content-wrapper {
                max-width: var(--max-width);
                margin: 0 auto;
                padding: 1.5rem 1rem;
                width: 100%;
            }

            footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: var(--space-lg);
                color: var(--color-text-light);
                border-top: 1px solid var(--color-border);
                max-width: var(--max-width);
                margin: 0 auto;
                width: 100%;
            }

            footer p {
                margin: 0;
                font-size: var(--font-sm);
            }

            footer nav {
                display: flex;
                gap: var(--space-lg);
                margin: 0;
                padding: 0;
                border: none;
            }

            footer nav a {
                color: var(--color-text-light);
                text-decoration: none;
                font-size: var(--font-sm);
            }

            footer nav a:hover {
                opacity: 0.7;
            }

            .container {
                max-width: var(--max-width);
                margin: 0 auto;
            }

            .meta {
                color: var(--color-text-light);
                font-size: var(--font-base);
            }

            /* hamburger menu styles */
            .hamburger-menu {
                position: relative;
                z-index: 1000;
            }

            .menu-toggle {
                display: none;
            }

            .menu-icon {
                font-size: 1.25rem;
                line-height: 1;
                user-select: none;
                cursor: pointer;
                display: block;
                padding: 0.5rem;
            }

            .menu-icon-open {
                display: inline-block;
            }

            .menu-icon-close {
                display: none;
            }

            .menu-dropdown {
                position: absolute;
                top: 100%;
                right: 0;
                margin-top: 8px;
                background: white;
                border: 1px solid var(--color-border-dark);
                border-radius: var(--border-radius);
                min-width: 150px;
                opacity: 0;
                visibility: hidden;
                transform: translateY(-10px);
                transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            }

            .menu-toggle:checked ~ .menu-dropdown {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

            .menu-toggle:checked ~ .menu-icon .menu-icon-open {
                display: none;
            }

            .menu-toggle:checked ~ .menu-icon .menu-icon-close {
                display: inline-block;
            }

            .menu-dropdown a {
                display: block;
                padding: 12px 16px;
                color: var(--color-text);
                text-decoration: none;
                font-size: 0.9rem;
                border-bottom: 1px solid var(--color-border);
            }

            .menu-dropdown a:last-child {
                border-bottom: none;
            }

            .menu-dropdown a:hover {
                background: var(--color-bg-light);
            }

            /* typography */
            h1 {
                font-size: 1.3rem;
                font-weight: 500;
                margin: 0 0 1.5rem 0;
                line-height: 1.2;
            }

            h2 {
                font-size: 1.1rem;
                font-weight: 500;
                margin: 1.5rem 0 0.5rem 0;
            }

            h3 {
                font-size: 1rem;
                font-weight: 500;
                margin-top: var(--space-lg);
                margin-bottom: var(--space-sm);
            }

            p {
                margin-bottom: 1em;
            }

            a {
                color: var(--color-text);
                text-decoration: none;
                cursor: pointer;
            }

            a:hover {
                opacity: 0.7;
            }

            ul {
                list-style: none;
                margin-bottom: 0.75rem;
            }

            ul li {
                margin-bottom: 0.35rem;
                padding-left: 1rem;
                position: relative;
                font-size: 1rem;
            }

            ul li::before {
                content: "•";
                position: absolute;
                left: 0;
            }

            code {
                background: var(--color-bg-light);
                padding: 2px 6px;
                border-radius: 3px;
                font-family: var(--font-mono);
                font-size: 13px;
            }

            .issue-list {
                list-style: none;
                padding: 0;
            }

            .issue-item {
                padding: var(--space-md) 0;
            }

            .issue-item:hover {
                background: var(--color-bg-light);
            }

            .issue-header {
                display: flex;
                align-items: center;
                gap: var(--space-sm);
                margin-bottom: var(--space-xs);
            }

            .issue-id {
                font-family: var(--font-mono);
                color: var(--color-text-light);
                font-size: var(--font-base);
            }

            .issue-title {
                font-size: var(--font-lg);
                font-weight: 500;
                color: var(--color-primary);
                text-decoration: none;
            }

            .issue-title:hover {
                text-decoration: underline;
            }

            .badge {
                display: inline-block;
                padding: var(--space-xs) var(--space-sm);
                border-radius: var(--border-radius);
                font-size: var(--font-sm);
                font-weight: 500;
            }

            .badge.priority {
                background: var(--color-error-bg);
                color: var(--color-error);
            }

            .badge.priority.p1 {
                background: var(--color-warning-bg);
                color: var(--color-warning);
            }

            .badge.priority.p2 {
                background: var(--color-success-bg);
                color: var(--color-success);
            }

            .badge.status {
                background: var(--color-primary-light);
                color: var(--color-primary);
            }

            .badge.status.closed {
                background: var(--color-success-bg);
                color: var(--color-success);
            }

            .badge.session {
                background: var(--color-neutral);
                color: var(--color-neutral-text);
                font-family: var(--font-mono);
            }

            .badge.client {
                background: var(--color-purple-bg);
                color: var(--color-purple);
            }

            .issue-meta {
                font-size: var(--font-base);
                color: var(--color-text-light);
                display: flex;
                gap: var(--space-sm);
                flex-wrap: wrap;
            }

            .session-list {
                list-style: none;
                padding: 0;
            }

            .session-item {
                padding: var(--space-md) 0;
                border: 1px solid var(--color-border);
                border-radius: var(--border-radius);
                margin-bottom: var(--space-md);
            }

            .session-item:hover {
                border-color: var(--color-primary);
                background: var(--color-primary-lighter);
            }

            .session-header {
                font-size: var(--font-lg);
                font-weight: 500;
                margin-bottom: var(--space-xs);
            }

            .session-meta {
                display: flex;
                gap: var(--space-md);
                font-size: var(--font-md);
                color: var(--color-text-light);
            }

            .empty {
                text-align: center;
                padding: 40px var(--space-xl);
                color: var(--color-text-lighter);
            }

            .error {
                padding: var(--space-sm) var(--space-md);
                background: var(--color-error-bg);
                border: 1px solid #fcc;
                border-radius: var(--border-radius);
                color: var(--color-error);
                font-size: var(--font-md);
            }

            .stats-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
                gap: var(--space-sm);
                margin-bottom: var(--space-lg);
            }

            .charts {
                display: flex;
                flex-direction: column;
                gap: var(--space-md);
            }

            /* login page */
            .login-container {
                text-align: center;
                padding: 60px var(--space-xl);
            }

            .login-container h1 {
                font-size: var(--font-2xl);
                margin-bottom: var(--space-xl);
            }

            .login-container p {
                color: var(--color-text-light);
                margin-bottom: 40px;
            }

            .btn-github {
                display: inline-block;
                padding: var(--space-md) 24px;
                background: var(--color-github);
                color: white;
                border: none;
                border-radius: 6px;
                font-weight: 500;
                cursor: pointer;
                font-size: var(--font-lg);
            }

            /* tabs navigation */
            .tabs {
                display: flex;
                gap: var(--space-lg);
                margin-bottom: var(--space-md);
            }

            .tabs a {
                text-decoration: none;
                color: var(--color-text-light);
                font-size: var(--font-base);
                transition: all 0.2s;
            }

            .tabs a:hover {
                color: var(--color-text);
            }

            .tabs a.active {
                color: var(--color-text);
                font-weight: 500;
            }

            /* notice/coming soon */
            .notice {
                background: var(--color-bg-light);
                border: 1px solid var(--color-border-dark);
                border-radius: var(--space-sm);
                padding: 30px;
                text-align: center;
            }

            .notice h3 {
                margin: 0 0 15px 0;
                font-size: var(--font-xl);
                color: var(--color-text-light);
            }

            .notice p {
                margin: var(--space-sm) 0;
                color: var(--color-text-light);
                line-height: 1.6;
            }

            .notice pre {
                display: inline-block;
                background: var(--color-neutral);
                padding: var(--space-sm) var(--space-xl);
                border-radius: var(--border-radius);
                margin-top: 15px;
            }

            .notice code {
                font-family: var(--font-mono);
                color: var(--color-primary);
            }

            /* forms */
            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 30px;
            }

            .back-link {
                color: var(--color-primary);
                text-decoration: none;
                font-size: var(--font-base);
            }

            .back-link:hover {
                text-decoration: underline;
            }

            .issue-form,
            .update-form {
                max-width: 600px;
            }

            .update-form {
                background: var(--color-bg-light);
                padding: var(--space-lg);
                border-radius: var(--border-radius);
            }

            .form-group {
                margin-bottom: var(--space-xl);
            }

            .form-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: var(--space-xl);
            }

            label {
                display: block;
                margin-bottom: var(--space-sm);
                font-weight: 500;
                color: var(--color-text);
                font-size: var(--font-sm);
            }

            input[type="text"],
            textarea,
            select {
                width: 100%;
                padding: var(--space-sm) var(--space-sm);
                border: 1px solid var(--color-border-dark);
                border-radius: var(--border-radius);
                font-family: inherit;
                font-size: var(--font-base);
            }

            input[type="text"]:focus,
            textarea:focus,
            select:focus {
                outline: none;
                border-color: var(--color-primary);
                box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
            }

            .form-actions {
                display: flex;
                gap: var(--space-sm);
                margin-top: 30px;
            }

            .btn,
            .btn-primary,
            .btn-secondary,
            .btn-danger {
                padding: var(--space-sm) var(--space-xl);
                border-radius: var(--border-radius);
                font-size: var(--font-base);
                font-weight: 500;
                cursor: pointer;
                border: none;
                text-decoration: none;
                display: inline-block;
            }

            .btn-primary {
                background: var(--color-primary);
                color: white;
            }

            .btn-primary:hover {
                background: var(--color-primary-hover);
            }

            .btn-secondary {
                background: var(--color-neutral);
                color: var(--color-text);
            }

            .btn-secondary:hover {
                background: var(--color-neutral-dark);
            }

            .btn-danger {
                background: var(--color-error-dark);
                color: white;
            }

            .btn-danger:hover {
                background: var(--color-error-darker);
            }

            .btn-new {
                background: var(--color-primary);
                color: white;
                padding: var(--space-sm) var(--space-lg);
                border-radius: var(--border-radius);
                text-decoration: none;
                font-size: var(--font-base);
                font-weight: 500;
            }

            .btn-new:hover {
                background: var(--color-primary-hover);
            }

            .btn-clear-filter {
                background: var(--color-neutral);
                color: var(--color-text-light);
                padding: var(--space-sm) var(--space-lg);
                border-radius: var(--border-radius);
                text-decoration: none;
                font-size: var(--font-base);
                font-weight: 500;
            }

            .btn-clear-filter:hover {
                background: var(--color-neutral-dark);
                color: var(--color-text);
            }

            .btn-close {
                background: var(--color-success-bg);
                color: var(--color-success);
                border: 1px solid #cfc;
                padding: var(--space-xs) var(--space-md);
                border-radius: var(--border-radius);
                font-size: var(--font-sm);
                cursor: pointer;
                font-weight: 500;
            }

            .btn-close:hover {
                background: var(--color-success-hover);
            }

            /* header row */
            .header-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: var(--space-xl);
            }

            /* label groups */
            .label-groups {
                display: flex;
                flex-direction: column;
                gap: 30px;
            }

            .label-group h3 {
                margin-bottom: var(--space-md);
                font-size: var(--font-lg);
                display: flex;
                align-items: center;
                gap: var(--space-sm);
            }

            .count {
                color: var(--color-text-light);
                font-size: var(--font-base);
                font-weight: normal;
            }

            /* source list */
            .source-list {
                list-style: none;
                display: grid;
                gap: var(--space-xl);
            }

            .source-item {
                padding: var(--space-xl);
                background: var(--color-bg-light);
                border-radius: var(--space-sm);
                border: 1px solid var(--color-border);
            }

            .source-item:hover {
                border-color: var(--color-primary);
                background: var(--color-primary-lighter);
            }

            .source-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: var(--space-sm);
            }

            .source-name {
                margin: 0;
                font-size: var(--font-xl);
                font-weight: 500;
            }

            .source-badges {
                display: flex;
                gap: var(--space-sm);
            }

            .badge.type {
                background: var(--color-primary-light);
                color: var(--color-primary);
            }

            .badge.type.local {
                background: var(--color-success-bg);
                color: var(--color-success-dark);
            }

            .badge.type.virtual {
                background: var(--color-purple-bg);
                color: var(--color-purple);
            }

            .source-path,
            .repo-url {
                font-family: var(--font-mono);
                font-size: var(--font-sm);
                color: var(--color-text-light);
                margin-bottom: 15px;
                padding: var(--space-sm);
                background: var(--color-bg);
                border-radius: var(--border-radius);
                overflow-x: auto;
            }

            .source-stats,
            .repo-stats {
                display: flex;
                gap: 30px;
                margin: 15px 0;
                padding: 15px 0;
                border-top: 1px solid var(--color-border-dark);
                border-bottom: 1px solid var(--color-border-dark);
            }

            .stat {
                display: flex;
                flex-direction: column;
                gap: 5px;
            }

            .stat-value {
                font-size: var(--font-2xl);
                font-weight: 600;
                color: var(--color-text);
            }

            .stat-label {
                font-size: var(--font-sm);
                color: var(--color-text-lighter);
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .source-meta {
                font-size: var(--font-base);
                color: var(--color-text-lighter);
            }

            /* repo list */
            .repo-list {
                list-style: none;
                display: grid;
                gap: 15px;
            }

            .repo-item {
                background: var(--color-bg-light);
                border-radius: var(--space-sm);
                border: 1px solid var(--color-border);
                transition: all 0.2s;
            }

            .repo-item:hover {
                border-color: var(--color-primary);
                background: var(--color-primary-lighter);
                transform: translateY(-1px);
                box-shadow: 0 2px 8px rgba(0, 102, 204, 0.1);
            }

            .repo-link {
                display: block;
                padding: var(--space-xl);
                text-decoration: none;
                color: inherit;
            }

            .repo-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: var(--space-sm);
            }

            .repo-name {
                margin: 0;
                font-size: var(--font-xl);
                font-weight: 500;
                color: var(--color-text);
            }

            .repo-stats-inline {
                display: flex;
                gap: var(--space-sm);
            }

            .stat-badge {
                padding: var(--space-xs) var(--space-md);
                border-radius: 12px;
                font-size: var(--font-sm);
                font-weight: 500;
            }

            .stat-badge.open {
                background: var(--color-success-bg);
                color: var(--color-success-dark);
            }

            .stat-badge.closed {
                background: var(--color-neutral);
                color: var(--color-text-light);
            }

            /* issue detail */
            .issue-detail {
                max-width: 900px;
                margin: 0 auto;
            }

            .issue-detail .issue-header {
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: var(--space-sm);
                padding-bottom: var(--space-sm);
            }

            .header-left,
            .header-right {
                display: flex;
                align-items: center;
                gap: var(--space-sm);
            }

            .issue-detail .issue-title {
                font-size: var(--font-lg);
                margin: 0;
                font-weight: 600;
            }

            .issue-body {
                padding: var(--space-md);
                background: var(--color-bg-light);
                border-radius: var(--border-radius);
                margin-bottom: var(--space-md);
                white-space: pre-wrap;
                line-height: 1.5;
                font-size: var(--font-base);
            }

            .metadata-compact {
                margin-bottom: var(--space-lg);
                font-size: var(--font-md);
                padding: 6px 0;
            }

            .meta-row {
                display: flex;
                align-items: center;
                gap: var(--space-sm);
                padding: 2px 0;
            }

            .meta-label {
                color: var(--color-text-lighter);
                min-width: 60px;
                font-size: var(--font-sm);
            }

            .meta-value {
                color: var(--color-text);
            }

            .labels-list {
                display: flex;
                gap: 6px;
                flex-wrap: wrap;
            }

            .badge.label {
                background: var(--color-primary-light);
                color: var(--color-primary);
                font-size: var(--font-sm);
                padding: 2px var(--space-sm);
            }

            .actions-section {
                margin-top: var(--space-xl);
            }

            .actions-section h3 {
                font-size: var(--font-base);
                margin-bottom: var(--space-sm);
                color: var(--color-text-light);
                font-weight: 600;
            }

            .issue-actions {
                display: flex;
                gap: var(--space-sm);
            }

            /* stat card component */
            .stat-card {
                background: var(--color-bg-light);
                padding: var(--space-sm) var(--space-md);
                border-radius: var(--border-radius);
                text-align: center;
            }

            .stat-card .stat-value {
                font-size: var(--font-xl);
                font-weight: 600;
                color: var(--color-primary);
                margin-bottom: var(--space-xs);
            }

            .stat-card .stat-label {
                font-size: var(--font-sm);
                color: var(--color-text-light);
                text-transform: lowercase;
            }

            /* chart section component */
            .chart-section {
                background: var(--color-bg-light);
                padding: var(--space-sm) var(--space-md);
                border-radius: var(--border-radius);
            }

            .chart-section h3 {
                margin-bottom: var(--space-sm);
                font-size: var(--font-md);
                font-weight: 500;
            }

            .chart-bars {
                display: flex;
                flex-direction: column;
                gap: var(--space-xs);
            }

            .chart-bar {
                display: grid;
                grid-template-columns: 80px 1fr 40px;
                align-items: center;
                gap: var(--space-sm);
            }

            .bar-label {
                font-size: var(--font-sm);
                color: var(--color-text-light);
                text-align: right;
            }

            .bar-container {
                background: var(--bar-bg);
                height: 12px;
                border-radius: var(--border-radius-sm);
                overflow: hidden;
            }

            .bar-fill {
                background: var(--color-primary);
                height: 100%;
                border-radius: var(--border-radius-sm);
                transition: width 0.3s ease;
            }

            .bar-value {
                font-size: var(--font-sm);
                font-weight: 500;
                color: var(--color-text);
                text-align: center;
            }
        </style>
    </head>
