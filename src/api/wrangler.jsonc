{
  "name": "beadster-dev-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-17",
  "compatibility_flags": ["nodejs_compat"],

  "account_id": "497c361ec2693b656492eccf2a43849a",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beadster-dev-db",
      "database_id": "739ce35d-70a6-4075-9527-fa796ea73ba0"
    }
  ],

  "vars": {
    "ENVIRONMENT": "development",
    "BASE_URL": "https://beadster-dev-api.systemoperator.workers.dev",
    "GITHUB_CLIENT_ID": "placeholder_add_via_dashboard_or_dev_vars"
  },

  "observability": {
    "enabled": true
  },

  "routes": [
    {
      "pattern": "api.beadster.ai",
      "custom_domain": true,
    },
  ],
}
